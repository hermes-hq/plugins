{
  "id": "hermes-hq.rss-reader",
  "name": "RSS Feed Reader",
  "version": "1.0.4",
  "description": "Subscribe to RSS and Atom feeds, browse articles, and get notified of new content without leaving the terminal",
  "author": "Hermes IDE",
  "main": "dist/index.js",
  "activationEvents": [
    { "type": "onStartup" }
  ],
  "contributes": {
    "commands": [
      {
        "command": "rss-reader.openPanel",
        "title": "Open RSS Feed Reader",
        "category": "RSS Reader"
      },
      {
        "command": "rss-reader.refreshAll",
        "title": "Refresh All Feeds",
        "category": "RSS Reader"
      },
      {
        "command": "rss-reader.addFeed",
        "title": "Add Feed",
        "category": "RSS Reader"
      }
    ],
    "panels": [
      {
        "id": "rss-reader-panel",
        "name": "RSS Reader",
        "side": "left",
        "icon": "<svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"4\" cy=\"14\" r=\"1.5\" fill=\"currentColor\" stroke=\"none\"/><path d=\"M3 9.5a5.5 5.5 0 0 1 5.5 5.5\"/><path d=\"M3 5a10 10 0 0 1 10 10\"/></svg>"
      }
    ],
    "statusBarItems": [
      {
        "id": "rss-reader.unread-count",
        "text": "RSS: 0",
        "tooltip": "Unread articles",
        "alignment": "right",
        "priority": 30,
        "command": "rss-reader.openPanel"
      }
    ],
    "settings": [
      {
        "key": "refreshInterval",
        "type": "select",
        "default": "30",
        "title": "Auto-refresh interval (minutes)",
        "options": [
          { "label": "15 minutes", "value": "15" },
          { "label": "30 minutes", "value": "30" },
          { "label": "60 minutes", "value": "60" },
          { "label": "Manual only", "value": "0" }
        ]
      },
      {
        "key": "maxArticlesPerFeed",
        "type": "select",
        "default": "50",
        "title": "Max articles per feed",
        "options": [
          { "label": "25", "value": "25" },
          { "label": "50", "value": "50" },
          { "label": "100", "value": "100" }
        ]
      }
    ]
  },
  "permissions": [
    "network",
    "storage",
    "clipboard.read",
    "clipboard.write"
  ]
}
