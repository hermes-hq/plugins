{
  "id": "hermes-hq.markdown-preview",
  "name": "Markdown Preview",
  "version": "1.0.0",
  "description": "Live preview of Markdown files with GitHub Flavored Markdown support",
  "author": "Hermes IDE",
  "main": "dist/index.js",
  "activationEvents": [
    {
      "type": "onStartup"
    }
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown-preview.open",
        "title": "Open Markdown Preview",
        "category": "Markdown"
      },
      {
        "command": "markdown-preview.refresh",
        "title": "Refresh Preview",
        "category": "Markdown"
      }
    ],
    "panels": [
      {
        "id": "markdown-preview-panel",
        "name": "Markdown",
        "side": "left",
        "icon": "<svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"2\" width=\"14\" height=\"14\" rx=\"2\"/><path d=\"M5 12V6l2.5 3L10 6v6\"/><path d=\"M13 9.5l-1.5 2.5L10 9.5\"/></svg>"
      }
    ],
    "statusBarItems": [
      {
        "id": "markdown-preview.status",
        "text": "MD",
        "tooltip": "Markdown Preview",
        "alignment": "right",
        "priority": 45,
        "command": "markdown-preview.open"
      }
    ],
    "settings": {
      "pollInterval": {
        "type": "select",
        "title": "Auto-refresh interval",
        "description": "How often to check for file changes",
        "default": "2000",
        "order": 1,
        "options": [
          { "value": "1000", "label": "1 second" },
          { "value": "2000", "label": "2 seconds" },
          { "value": "5000", "label": "5 seconds" },
          { "value": "0", "label": "Manual only" }
        ]
      }
    }
  },
  "permissions": [
    "shell.exec",
    "sessions.read",
    "storage"
  ]
}
