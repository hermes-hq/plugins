{
  "id": "hermes-hq.markdown-preview",
  "name": "Markdown Preview",
  "version": "1.1.0",
  "description": "Rich preview and editor for Markdown files with Mermaid diagram support",
  "author": "Hermes IDE",
  "main": "dist/index.js",
  "activationEvents": [
    {
      "type": "onStartup"
    }
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown-preview.save",
        "title": "Save Markdown File",
        "category": "Markdown"
      }
    ],
    "statusBarItems": [
      {
        "id": "markdown-preview.status",
        "text": "MD",
        "tooltip": "Markdown Preview",
        "alignment": "right",
        "priority": 45
      }
    ]
  },
  "permissions": [
    "shell.exec",
    "sessions.read",
    "storage"
  ]
}
